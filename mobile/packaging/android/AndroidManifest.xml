<?xml version="1.0" encoding="utf-8"?>
<!-- NativeActivity manifest for the Horizon library (libhorizon_android.so).
     Not built or installed yet: see docs/android.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.horizon.mobile">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Horizon" android:hasCode="false" android:largeHeap="true">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="horizon_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
