#version 460
// RT lighting's bounced light, ReSTIR GI (gfx/shadow_rays.wgsl `restir_gi`), as a ray tracing
// pipeline (docs/rtx-4090-handoff.md, "Next" 2): for each mask texel of a view, the trace kernel's
// whole GI, ported one for one, with the hardware reordering the threads by what they hit
// (`reorderThreadNV`) before each hit is shaded:
// - the new sample (`gi_sample`): a cosine-weighted ray from the primary surface; at its hit the
//   surface's colour (`hw_hit`), the sun's light through a shadow ray (`sun_on`) and the rest
//   (`bounce_rest`: the radiance cache, the last frame's screen, else a second bounce, its own hit
//   lit the same way);
// - the reuse (`restir_gi`): the last frame's reservoir where the surface was and two neighbours'
//   there, a sample taken from elsewhere kept only if this pixel sees it (a visibility ray).
// The kernel takes the reservoir and the light from here (`gi_pass_a`, `gi_pass_b`).
//
// What this pass leaves to the kernel (`gi_b` w 0), so that the picture stays the kernel's: a
// ray (the bounces', their sun rays) that crossed water, stained glass or ice (their tint and
// caustics, `hw_tint`); a hit with no sprite colour (the block grid's); a second bounce lit by
// neither the cache nor the last frame (`open_light`'s light sources); the Eye of Aldhani (its
// glow in the sky); the texels the kernel rests this frame. One difference, measured apart: the
// visibility ray meets the drawn triangles (the kernel's marches its voxel grid).
//
// Outputs, a texel a ray, the kernel's reservoir as it stores it (`gi_out_a`, `gi_out_b`): `gi_a`
// the chosen sample's point (camera-relative) and its weight; `gi_b` its light (halves: r g, b
// and the candidates seen), its face (snorm8x4), and w: 0 the kernel traces, 1 the pass's
// reservoir, 2 the same and this frame's own ray reached the sky.
#extension GL_EXT_ray_tracing : require
#extension GL_NV_shader_invocation_reorder : require
#extension GL_EXT_samplerless_texture_functions : require

// A moving vertex's words (mesher::Vertex, gfx/hw_rays.rs checks it): its stride in `dynamics`.
const uint DYN_WORDS = 11u;
layout(std140, set = 0, binding = 0) uniform Rt {
    mat4 inverse_view_proj;
    vec4 light;
    vec4 camera;
    vec4 fraction;
    vec4 grid;
    vec4 size;
    vec4 fovea;
    vec4 mode;
    mat4 prev_view_proj;
    vec4 motion;
    vec4 sun;
    vec4 frame;
    vec4 sun_light;
    vec4 water;
    vec4 hw_offset;
    vec4 held;
    vec4 far;
    vec4 moving[8];
    vec4 rain;
    vec4 rain_sun;
    mat4 first_view_proj;
    mat4 first_inverse_view_proj;
} rt;
layout(set = 0, binding = 1) uniform texture2D depth;
layout(set = 0, binding = 3) uniform accelerationStructureEXT terrain;
layout(set = 0, binding = 4) readonly buffer Arena0 { uint w[]; } arena0;
layout(set = 0, binding = 5) readonly buffer Arena1 { uint w[]; } arena1;
layout(set = 0, binding = 6) readonly buffer Arena2 { uint w[]; } arena2;
layout(set = 0, binding = 7) readonly buffer Arena3 { uint w[]; } arena3;
layout(set = 0, binding = 8) readonly buffer Arena4 { uint w[]; } arena4;
layout(set = 0, binding = 9) readonly buffer Arena5 { uint w[]; } arena5;
layout(set = 0, binding = 10) readonly buffer Arena6 { uint w[]; } arena6;
layout(set = 0, binding = 11) readonly buffer Arena7 { uint w[]; } arena7;
layout(set = 0, binding = 12) uniform texture2DArray sprites;
layout(set = 0, binding = 13) readonly buffer Instances { uvec4 rows[]; } instances;
layout(set = 0, binding = 14) readonly buffer Dynamics { uint w[]; } dynamics;
layout(set = 0, binding = 15) uniform texture2D entity_atlas;
layout(set = 0, binding = 16, rgba32f) uniform writeonly image2D gi_a;
layout(set = 0, binding = 17, rgba32ui) uniform writeonly uimage2D gi_b;
// The kernel's: the sky table, the last frame's masks (distance in `last_mask`'s a, the light
// other than the sun's in `last_light_mask`, the face in `last_direct`'s a), its reservoirs, and
// the radiance cache (nine words a cell, `CacheCell`).
layout(set = 0, binding = 18) uniform texture2D sky_view;
layout(set = 0, binding = 19) uniform texture2D last_mask;
layout(set = 0, binding = 20) uniform texture2D last_light_mask;
layout(set = 0, binding = 21) uniform texture2D last_direct;
layout(set = 0, binding = 22) uniform texture2D last_gi_a;
layout(set = 0, binding = 23) uniform utexture2D last_gi_b;
layout(set = 0, binding = 24) readonly buffer Cache { uint w[]; } cache;
// `sprite_split` as sun.rahit's; `flags` bit 0: reorder the threads (`HORIZON_RT_SER=0` clears it,
// to time what the reordering gives); bits 2 and 3: the kernel's `GI_TURN_BITS` (2 or 3); bit 4:
// the kernel's `SKIP` 16 (the bounced light never rests).
layout(push_constant) uniform Push { uint sprite_split; uint flags; } push;

// sun.rahit sets it below 0 when a ray met a translucent quad (and let it through).
layout(location = 0) rayPayloadEXT float payload;
layout(location = 0) hitObjectAttributeNV vec2 bary;

const uint ARENA_PAGES = 8u;
const uint DYN_ENTITY = 0xfffffff0u;
const uint NO_QUAD = 0xffffffffu;
const uint NO_CLOUDS = 0xfbu;
const float UV_STEPS = 32768.0;
const float REACH = 4096.0;

// The kernel's `arena_at`, `hw_uv`, `hw_position`.
uint arena_at(uint v, uint k) {
    uint i = (v & 0x0fffffffu) * 6u + k;
    switch (v >> 28u) {
        case 0u: return arena0.w[i];
        case 1u: return arena1.w[i];
        case 2u: return arena2.w[i];
        case 3u: return arena3.w[i];
        case 4u: return arena4.w[i];
        case 5u: return arena5.w[i];
        case 6u: return arena6.w[i];
        default: return arena7.w[i];
    }
}
vec2 hw_uv(uint v) {
    uint w = arena_at(v, 3u);
    return vec2(float(w & 0xffffu), float(w >> 16u)) / UV_STEPS;
}
vec3 hw_position(uint v) {
    return uintBitsToFloat(uvec3(arena_at(v, 0u), arena_at(v, 1u), arena_at(v, 2u)));
}
vec3 dyn_position(uint v) {
    return uintBitsToFloat(uvec3(dynamics.w[v * DYN_WORDS], dynamics.w[v * DYN_WORDS + 1u], dynamics.w[v * DYN_WORDS + 2u]));
}

// The hit's place in the structures (`RayIntersection`'s fields the kernel reads).
struct Hit {
    uint instance;
    uint primitive;
    uint geometry;
    vec2 b;
};
uvec4 row_at(Hit h, uint k) {
    return instances.rows[h.instance * 3u + k];
}
// The kernel's `hw_entity_quad`, `hw_entity_texel`, `hw_quad` (solid), `hw_texel`.
uint hw_entity_quad(Hit h) {
    uvec4 at = row_at(h, 0u);
    if (at.x != DYN_ENTITY) return NO_QUAD;
    return at.y + (h.primitive / 2u) * 4u;
}
vec4 hw_entity_texel(Hit h, uint base) {
    bool second = (h.primitive & 1u) == 1u;
    uint v1 = base + (second ? 2u : 1u);
    uint v2 = base + (second ? 3u : 2u);
    vec2 uv = uintBitsToFloat(uvec2(dynamics.w[base * DYN_WORDS + 3u], dynamics.w[base * DYN_WORDS + 4u])) * (1.0 - h.b.x - h.b.y)
        + uintBitsToFloat(uvec2(dynamics.w[v1 * DYN_WORDS + 3u], dynamics.w[v1 * DYN_WORDS + 4u])) * h.b.x
        + uintBitsToFloat(uvec2(dynamics.w[v2 * DYN_WORDS + 3u], dynamics.w[v2 * DYN_WORDS + 4u])) * h.b.y;
    ivec2 size = textureSize(entity_atlas, 0);
    ivec2 texel = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
    vec4 color = unpackUnorm4x8(dynamics.w[base * DYN_WORDS + 6u]);
    return texelFetch(entity_atlas, texel, 0) * color;
}
uint hw_quad(Hit h) {
    uvec4 at = row_at(h, 0u);
    if (at.x >= ARENA_PAGES) return NO_QUAD;
    uint g = h.geometry;
    uvec4 words = row_at(h, 1u + g / 8u);
    uint w = words[(g / 2u) % 4u];
    uint first = at.y + ((w >> ((g & 1u) * 16u)) & 0xffffu) * 4u;
    return (at.x << 28u) | (first + (h.primitive / 2u) * 4u);
}
vec4 hw_texel(Hit h, uint base) {
    uint layer = arena_at(base, 4u) & 0x7fffu;
    if (layer >= push.sprite_split) return vec4(-1.0);
    bool second = (h.primitive & 1u) == 1u;
    vec2 uv = hw_uv(base) * (1.0 - h.b.x - h.b.y) + hw_uv(base + (second ? 2u : 1u)) * h.b.x
        + hw_uv(base + (second ? 3u : 2u)) * h.b.y;
    ivec2 size = textureSize(sprites, 0).xy;
    ivec2 texel = clamp(ivec2(uv * vec2(size)), ivec2(0), size - 1);
    return texelFetch(sprites, ivec3(texel, int(layer)), 0);
}

// The kernel's `surface_at`, `surface_normal`, `random2`, `blue2`, `cosine_dir`, `tile_of`.
vec3 surface_at(ivec2 p) {
    vec2 size = rt.size.xy;
    float d = texelFetch(depth, clamp(p, ivec2(0), ivec2(size) - 1), 0).r;
    vec2 ndc = vec2((float(p.x) + 0.5) / size.x * 2.0 - 1.0, 1.0 - (float(p.y) + 0.5) / size.y * 2.0);
    vec4 c = rt.inverse_view_proj * vec4(ndc, d, 1.0);
    return c.xyz / c.w;
}
vec3 surface_normal(ivec2 p, vec3 pos) {
    vec3 r = surface_at(p + ivec2(1, 0)) - pos;
    vec3 l = pos - surface_at(p - ivec2(1, 0));
    vec3 d = surface_at(p + ivec2(0, 1)) - pos;
    vec3 u = pos - surface_at(p - ivec2(0, 1));
    vec3 dx = dot(r, r) < dot(l, l) ? r : l;
    vec3 dy = dot(d, d) < dot(u, u) ? d : u;
    vec3 n = normalize(cross(dx, dy));
    return dot(n, pos) > 0.0 ? -n : n;
}
vec2 random2(ivec2 texel, uint salt) {
    uint v = uint(texel.x) * 1973u + uint(texel.y) * 9277u + uint(rt.frame.x) * 26699u + salt * 7919u;
    v = v * 747796405u + 2891336453u;
    uint w = ((v >> ((v >> 28u) + 4u)) ^ v) * 277803737u;
    w = (w >> 22u) ^ w;
    uint u = w * 747796405u + 2891336453u;
    u = ((u >> ((u >> 28u) + 4u)) ^ u) * 277803737u;
    u = (u >> 22u) ^ u;
    return vec2(float(w >> 8u), float(u >> 8u)) / 16777216.0;
}
// The kernel's `blue2` for the bounce (its stream `BLUE_GI`: the texel transposed), bit for
// bit: blue noise over the screen, low-discrepancy over the view's frames; white (`random2`)
// when `rt.mode.w`'s bit 4 says `HORIZON_RT_SKIP` 2097152 asked for it.
vec2 blue2(ivec2 texel, uint salt) {
    if ((uint(rt.mode.w) & 4u) != 0u) return random2(texel, salt);
    uvec2 q = uvec2(texel).yx;
    uint k = uint(rt.frame.z);
    uint r2 = q.x * 3242174889u + q.y * 2447445413u + k * 773608062u;
    uint inner = q.y * 288237660u + q.x * 25070368u;
    uint ign = inner * 52u + (inner >> 16u) * 64417u + (((inner & 0xffffu) * 64417u) >> 16u)
        + k * 3014823329u;
    return vec2(float(r2 >> 8u), float(ign >> 8u)) / 16777216.0;
}
vec3 cosine_dir(vec3 n, vec2 u) {
    vec3 t = normalize(abs(n.y) > 0.9 ? cross(n, vec3(1.0, 0.0, 0.0)) : cross(n, vec3(0.0, 1.0, 0.0)));
    vec3 b = cross(n, t);
    float r = sqrt(u.x);
    float a = 6.2831853 * u.y;
    return normalize((t * cos(a) + b * sin(a)) * r + n * sqrt(max(1.0 - u.x, 0.0)));
}
uint tile_of(uvec2 t, uint bits) {
    uint k = (t.x & 1u) | ((t.y & 1u) << 1u) | (((t.x >> 1u) & 1u) << 2u);
    return k & ((1u << bits) - 1u);
}


float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}
// The kernel's `finite`: NaNs and infinities as 0, by their bits.
float finite(float x) {
    return (floatBitsToUint(x) & 0x7f800000u) == 0x7f800000u ? 0.0 : x;
}
vec3 finite3(vec3 v) {
    return vec3(finite(v.x), finite(v.y), finite(v.z));
}
float face_of(vec3 n) {
    vec3 a = abs(n);
    float axis = 2.0;
    if (a.x >= a.y && a.x >= a.z) {
        axis = 0.0;
    } else if (a.y >= a.z) {
        axis = 1.0;
    }
    float s = axis < 2.0 ? (axis == 0.0 ? n.x : n.y) : n.z;
    return axis * 2.0 + (s < 0.0 ? 1.0 : 0.0);
}
float face_in(float a) {
    return a - 8.0 * floor(a / 8.0);
}

// The kernel's `sky_table` (`sky_at` but for the Eye of Aldhani, which this pass leaves to it).
vec3 sky_texel(ivec2 at, ivec2 top) {
    return texelFetch(sky_view, clamp(at, ivec2(0), top), 0).rgb;
}
vec3 sky_at(vec3 d) {
    vec2 flat_d = d.xz / max(length(d.xz), 1e-5);
    vec2 sun = rt.sun.xz / max(length(rt.sun.xz), 1e-5);
    float azimuth = acos(clamp(dot(flat_d, sun), -1.0, 1.0)) / 3.14159265;
    float e = asin(clamp(d.y, -1.0, 1.0)) / 1.5707963;
    vec2 size = vec2(textureSize(sky_view, 0));
    vec2 p = vec2(azimuth, 0.5 + 0.5 * sign(e) * sqrt(abs(e))) * size - 0.5;
    ivec2 base = ivec2(floor(p));
    vec2 f = p - floor(p);
    ivec2 top = ivec2(size) - 1;
    vec3 low = mix(sky_texel(base, top), sky_texel(base + ivec2(1, 0), top), f.x);
    vec3 high = mix(sky_texel(base + ivec2(0, 1), top), sky_texel(base + ivec2(1, 1), top), f.x);
    return mix(low, high, f.y);
}

// The kernel's radiance cache, read: `cache_key`, `cache_slot` (no insert), `cache_light`.
const uint CACHE_PROBES = 8u;
const uint CACHE_WORDS = 9u;
uint cache_key(vec3 pos, vec3 n) {
    float d = max(length(pos), 1.0);
    uint level = uint(clamp(floor(log2(d / 8.0)), 0.0, 9.0));
    float size = 0.5 * exp2(float(level));
    vec3 world = pos + rt.camera.xyz + rt.fraction.xyz;
    ivec3 c = ivec3(floor(world / size));
    uint h = uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u;
    h ^= (level * 2654435761u) ^ (uint(face_of(n)) * 2246822519u);
    h = (h ^ (h >> 15u)) * 2246822519u;
    h = (h ^ (h >> 13u)) * 3266489917u;
    h ^= h >> 16u;
    return max(h, 1u);
}
vec4 cache_light(vec3 pos, vec3 n) {
    uint key = cache_key(pos, n);
    uint mask = uint(cache.w.length()) / CACHE_WORDS - 1u;
    for (uint i = 0u; i < CACHE_PROBES; i++) {
        uint slot = (key + i * i) & mask;
        uint held = cache.w[slot * CACHE_WORDS];
        if (held == key) {
            uint r = cache.w[slot * CACHE_WORDS + 5u];
            if (r == 0xffffffffu) return vec4(0.0, 0.0, 0.0, -1.0);
            return vec4(uintBitsToFloat(r), uintBitsToFloat(cache.w[slot * CACHE_WORDS + 6u]),
                uintBitsToFloat(cache.w[slot * CACHE_WORDS + 7u]), 1.0);
        }
        if (held == 0u) break;
    }
    return vec4(0.0, 0.0, 0.0, -1.0);
}
// The kernel's `last_light`: the last frame's light other than the sun's where it showed `at`.
vec4 last_light(vec3 at) {
    if (rt.motion.w < 0.5) return vec4(0.0, 0.0, 0.0, -1.0);
    vec3 q = at + rt.motion.xyz;
    vec4 c = rt.prev_view_proj * vec4(q, 1.0);
    if (c.w <= 0.0) return vec4(0.0, 0.0, 0.0, -1.0);
    vec2 ndc = c.xy / c.w;
    if (any(greaterThan(abs(ndc), vec2(1.0)))) return vec4(0.0, 0.0, 0.0, -1.0);
    vec2 size = vec2(textureSize(last_mask, 0));
    ivec2 texel = clamp(ivec2(vec2((ndc.x * 0.5 + 0.5) * size.x, (0.5 - ndc.y * 0.5) * size.y)),
        ivec2(0), ivec2(size) - 1);
    float d = length(q);
    float shown = texelFetch(last_mask, texel, 0).a;
    if (shown < 0.0 || abs(shown - d) > 0.1 + 0.03 * d) return vec4(0.0, 0.0, 0.0, -1.0);
    vec4 light = texelFetch(last_light_mask, texel, 0);
    if (light.a < 0.0) return vec4(0.0, 0.0, 0.0, -1.0);
    return vec4(light.rgb, 1.0);
}
vec4 cached_on(vec3 at, vec3 n) {
    vec4 cached = cache_light(at, n);
    if (cached.a >= 0.0) return cached;
    return last_light(at);
}
// The kernel's `restir_last`: where camera-relative `pos` was in the last frame's masks (xy), z 1
// when it showed it there.
ivec3 restir_last(vec3 pos) {
    if (rt.motion.w < 0.5) return ivec3(0);
    vec3 q = pos + rt.motion.xyz;
    vec4 c = rt.prev_view_proj * vec4(q, 1.0);
    if (c.w <= 0.0) return ivec3(0);
    vec2 ndc = c.xy / c.w;
    if (any(greaterThan(abs(ndc), vec2(1.0)))) return ivec3(0);
    vec2 size = vec2(textureSize(last_mask, 0));
    ivec2 at = ivec2(vec2((ndc.x * 0.5 + 0.5) * size.x, (0.5 - ndc.y * 0.5) * size.y));
    vec4 last = texelFetch(last_mask, clamp(at, ivec2(0), ivec2(size) - 1), 0);
    float d = length(q);
    if (last.a < 0.0 || abs(last.a - d) > 0.05 + 0.02 * d) return ivec3(at, 0);
    return ivec3(at, 1);
}

// A ray's hit, shaded after the reorder (`hw_hit` without its tint): false when the ray met a
// translucent quad or a hit has no sprite colour (the kernel's then). `t` below 0: no hit.
bool trace_hit(vec3 from, vec3 d, float reach, out float t, out vec3 normal, out vec3 albedo) {
    t = -1.0;
    normal = -d;
    albedo = vec3(0.0);
    payload = 0.0;
    hitObjectNV hit;
    hitObjectTraceRayNV(hit, terrain, 0u, NO_CLOUDS, 0, 0, 0, from + rt.hw_offset.xyz, 0.0, d, reach, 0);
    if ((push.flags & 1u) != 0u) reorderThreadNV(hit);
    if (payload < 0.0) return false;
    if (!hitObjectIsHitNV(hit)) return true;
    hitObjectGetAttributesNV(hit, 0);
    Hit h = Hit(uint(hitObjectGetInstanceCustomIndexNV(hit)), uint(hitObjectGetPrimitiveIndexNV(hit)),
        uint(hitObjectGetGeometryIndexNV(hit)), bary);
    t = hitObjectGetRayTMaxNV(hit);
    vec3 colour = vec3(-1.0);
    uint entity = hw_entity_quad(h);
    uint base = entity == NO_QUAD ? hw_quad(h) : NO_QUAD;
    if (entity != NO_QUAD) {
        vec3 p0 = dyn_position(entity);
        vec3 f = cross(dyn_position(entity + 1u) - p0, dyn_position(entity + 2u) - p0);
        if (dot(f, f) > 1e-12) normal = normalize(f);
        colour = pow(max(hw_entity_texel(h, entity).rgb, vec3(0.0)), vec3(2.2));
    } else if (base != NO_QUAD) {
        vec3 p0 = hw_position(base);
        vec3 f = cross(hw_position(base + 1u) - p0, hw_position(base + 2u) - p0);
        if (dot(f, f) > 1e-12) normal = normalize(f);
        vec4 c = hw_texel(h, base);
        if (c.a >= 0.0) {
            uint w = arena_at(base, 5u);
            vec3 tint = vec3(float(w & 255u), float((w >> 8u) & 255u), float((w >> 16u) & 255u)) / 255.0;
            colour = pow(max(c.rgb * tint, vec3(0.0)), vec3(2.2));
        }
    }
    if (dot(normal, d) > 0.0) normal = -normal;
    albedo = colour;
    return colour.x >= 0.0;
}
// Whether a ray from `from` along `d` meets anything opaque within `reach`.
bool blocked(vec3 from, vec3 d, float reach) {
    payload = 0.0;
    hitObjectNV shadow;
    hitObjectTraceRayNV(shadow, terrain,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT, 0xffu,
        0, 0, 0, from + rt.hw_offset.xyz, 0.0, d, reach, 0);
    return hitObjectIsHitNV(shadow);
}
// The kernel's `sun_on`: false when the light crossed water or glass unblocked (its tint).
bool sun_on(vec3 lifted, vec3 n, out vec3 sun) {
    sun = vec3(0.0);
    float facing = dot(n, rt.light.xyz);
    if (facing <= 0.0 || rt.light.w <= 0.0) return true;
    if (blocked(lifted, rt.light.xyz, REACH)) return true;
    if (payload < 0.0) return false;
    sun = rt.sun_light.rgb * (rt.light.w * facing);
    return true;
}
// The kernel's `second_bounce`: the light along one more cosine-weighted ray, or false.
bool second_bounce(vec3 pos, vec3 n, ivec2 salt, out vec3 light) {
    light = vec3(0.0);
    vec3 d = cosine_dir(n, random2(salt, 3u));
    float t;
    vec3 normal, albedo;
    if (!trace_hit(pos, d, 256.0, t, normal, albedo)) return false;
    if (t < 0.0) {
        light = sky_at(d);
        return true;
    }
    vec3 at = pos + d * t;
    vec3 lifted = at + normal * 0.02;
    vec3 sun;
    if (!sun_on(lifted, normal, sun)) return false;
    vec4 last = cached_on(at, normal);
    // Neither: the kernel's `open_light` (the light sources' cells).
    if (last.a < 0.0) return false;
    light = albedo * (sun + last.rgb);
    return true;
}
// The kernel's `bounce_light`: the light leaving a hit toward the ray, or false.
bool bounce_light(vec3 at, vec3 n, vec3 albedo, out vec3 light) {
    light = vec3(0.0);
    vec3 lifted = at + n * 0.02;
    vec3 sun;
    if (!sun_on(lifted, n, sun)) return false;
    vec4 last = cached_on(at, n);
    vec3 rest = last.rgb;
    if (last.a < 0.0 && !second_bounce(lifted, n, ivec2(floor(at.xz * 16.0 + at.y * 7.0)), rest)) {
        return false;
    }
    light = albedo * (sun + rest);
    return true;
}

struct GiSample {
    vec3 at;
    vec3 normal;
    vec3 light;
};
// The kernel's `gi_sample`, or false.
bool gi_sample(vec3 pos, vec3 n, ivec2 texel, out GiSample s) {
    vec3 d = cosine_dir(n, blue2(texel, 1u));
    s = GiSample(pos + d * REACH, -d, vec3(0.0));
    float t;
    vec3 normal, albedo;
    if (!trace_hit(pos, d, REACH, t, normal, albedo)) return false;
    if (t < 0.0) {
        s.light = sky_at(d);
        return true;
    }
    vec3 at = pos + d * t;
    vec3 light;
    if (!bounce_light(at, normal, albedo, light)) return false;
    s = GiSample(at, normal, light);
    return true;
}
float gi_target(GiSample s, vec3 pos, vec3 n) {
    return luminance(s.light) * max(dot(n, normalize(s.at - pos)), 0.0);
}
GiSample last_gi(ivec2 at, out float weight, out float seen) {
    ivec2 size = textureSize(last_gi_a, 0);
    ivec2 c = clamp(at, ivec2(0), size - 1);
    vec4 a = texelFetch(last_gi_a, c, 0);
    uvec4 b = texelFetch(last_gi_b, c, 0);
    vec2 rg = unpackHalf2x16(b.x);
    vec2 bm = unpackHalf2x16(b.y);
    vec3 normal = unpackSnorm4x8(b.z).xyz;
    weight = a.w;
    seen = bm.y;
    return GiSample(a.xyz - rt.motion.xyz, normal, vec3(rg, bm.x));
}
const float GI_HISTORY = 20.0;

// The kernel's `sharp`: whether mask texel `texel` is in the sharp zone (VR's fovea, `rt.fovea`),
// from its view ray. Only there does the kernel read the pass (`sun_from_pass`: `cs_shadow` traces
// a texel whose 4x4 block's centre is sharp; the others share their block's ray, `cs_sparse`).
bool sharp(ivec2 texel) {
    if (rt.fovea.w < -1.0) return true;
    int scale = int(rt.size.z);
    ivec2 p = texel * scale + scale / 2;
    vec2 ndc = vec2((float(p.x) + 0.5) / rt.size.x * 2.0 - 1.0, 1.0 - (float(p.y) + 0.5) / rt.size.y * 2.0);
    vec4 c = rt.inverse_view_proj * vec4(ndc, 1.0, 1.0);
    return dot(normalize(c.xyz / c.w), rt.fovea.xyz) >= rt.fovea.w;
}

void main() {
    ivec2 texel = ivec2(gl_LaunchIDEXT.xy);
    int scale = int(rt.size.z);
    ivec2 p = texel * scale + scale / 2;
    // The kernel traces (w 0) unless the pass's reservoir is found below.
    vec4 a = vec4(0.0);
    uvec4 b = uvec4(0u);
    bool lit = rt.mode.x > 0.5;
    // The Eye of Aldhani lights the sky with its glow: the kernel's.
    bool aldhani = rt.held.y >= 0.0;
    // Outside the sharp zone the kernel never reads the pass: it traces (w 0), no ray here.
    if (lit && !aldhani && sharp((texel / 4) * 4 + 2) && float(p.x) < rt.size.x && float(p.y) < rt.size.y && texelFetch(depth, p, 0).r > 0.0) {
        vec3 pos = surface_at(p);
        vec3 n = surface_normal(p, pos);
        float reach = 0.5 * rt.grid.z;
        float edge = 1.0 - smoothstep(0.75 * reach, reach, max(abs(pos.x), abs(pos.z)));
        ivec3 back = restir_last(pos);
        bool has_last = back.z == 1;
        // The kernel's turns (`trace`): a tile traces its bounced light one frame in 2^bits
        // (`GI_TURN_BITS`, in the flags); the frames between it rests where the last frame showed
        // the surface, unless the kernel's anti-lag cut that surface's history (its flag: 32
        // added to the history in `last_direct`'s a, `antilag_in`) or its `SKIP` 16 says never
        // to rest. Both must agree: a texel the kernel traces and this pass rested would be
        // traced again by the kernel's own, far slower, bounce rays. Behind water or glass
        // (`behind_psr`, known only once the kernel traced the refraction) the kernel rests one
        // frame in eight: the same as here with 3 bits; with 2 this pass traces some texels the
        // kernel rests, never the other way round.
        uint bits = (push.flags >> 2u) & 3u;
        uvec2 tile = uvec2(texel) >> uvec2(3u);
        bool cut = has_last && floor(texelFetch(last_direct, back.xy, 0).a / 8.0) >= 32.0;
        bool rests = tile_of(tile, bits) != (uint(rt.frame.z) & ((1u << bits) - 1u)) && has_last
            && !cut && (push.flags & 16u) == 0u;
        if (edge > 0.0 && !rests) {
            // `restir_gi`'s `pos`: the surface lifted as `trace` lifts it.
            vec3 from = pos + n * (0.02 + 0.002 * length(pos));
            GiSample own;
            if (gi_sample(from, n, texel, own)) {
                GiSample chosen = own;
                float aim = gi_target(own, from, n);
                float sum = luminance(own.light) * 3.14159265;
                float seen = 1.0;
                bool reused = false;
                vec2 u = random2(texel, 70u);
                if (has_last) {
                    for (int j = 0; j < 3; j++) {
                        vec2 jitter = random2(texel, 80u + uint(j));
                        ivec2 off = j == 0 ? ivec2(0) : ivec2((jitter * 2.0 - 1.0) * 8.0);
                        float q_weight, q_seen;
                        GiSample q = last_gi(back.xy + off, q_weight, q_seen);
                        if (q_seen <= 0.0 || q_weight <= 0.0) continue;
                        if (j > 0) {
                            ivec2 size = textureSize(last_mask, 0);
                            ivec2 c = clamp(back.xy + off, ivec2(0), size - 1);
                            float depth_here = length(from);
                            if (abs(face_in(texelFetch(last_direct, c, 0).a) - face_of(n)) > 0.5
                                || abs(texelFetch(last_mask, c, 0).a - depth_here) > 0.05 * depth_here + 0.1) {
                                continue;
                            }
                        }
                        float pt = gi_target(q, from, n);
                        float m = min(q_seen, j == 0 ? GI_HISTORY : GI_HISTORY / 4.0);
                        float w = pt * q_weight * m;
                        sum += w;
                        seen += m;
                        u = fract(u + vec2(0.618034, 0.754878));
                        if (w > 0.0 && u.x * sum < w) {
                            chosen = q;
                            aim = pt;
                            reused = true;
                        }
                    }
                }
                float weight = aim > 0.0 ? sum / (seen * aim) : 0.0;
                if (reused && aim > 0.0) {
                    vec3 to = chosen.at - from;
                    float d = length(to);
                    float far = d > 4000.0 ? REACH : d - 0.05;
                    if (blocked(from, to / d, far)) {
                        chosen = own;
                        aim = gi_target(own, from, n);
                        weight = aim > 0.0 ? 3.14159265 * luminance(own.light) / aim : 0.0;
                        seen = 1.0;
                    }
                }
                chosen.light = min(finite3(chosen.light), vec3(60000.0));
                weight = min(finite(weight), 1e6);
                a = vec4(finite3(chosen.at), weight);
                bool sky = length(own.at - from) > 4000.0;
                b = uvec4(packHalf2x16(chosen.light.rg), packHalf2x16(vec2(chosen.light.b, seen)),
                    packSnorm4x8(vec4(chosen.normal, 0.0)), sky ? 2u : 1u);
            }
        }
    }
    imageStore(gi_a, texel, a);
    imageStore(gi_b, texel, b);
}
